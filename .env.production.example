# Production-like stack template for docker-compose.yml. Copy to `.env.production`, fill every
# value from your secret store, and never commit the copy. There are deliberately no working
# defaults: `docker compose --env-file .env.production config -q` fails until all are set.
# Passwords placed inside URLs must be URL-encoded.

APP_ENV=production

# PostgreSQL (owner-provisioned; do not reuse workstation instances)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Redis: rate limiting, Celery broker and result backend. Required; no per-process fallback.
REDIS_PASSWORD=

# Authentication and web origin (HTTPS only outside development)
AUTH_SECRET=
SEED_PASSWORD=
WEB_ORIGIN=
ALLOWED_ORIGINS=
ALLOWED_HOSTS=
HEALTHCHECK_HOST=
# The browser calls the same-origin /api path; the web service's /api route forwards it at
# request time to BACKEND_INTERNAL_URL (set on the web service), so no public API origin is needed
# and no backend address is built into the frontend.

# Optional bind addresses (default 127.0.0.1 behind an owner-supplied TLS reverse proxy)
# API_BIND_ADDRESS=127.0.0.1
# WEB_BIND_ADDRESS=127.0.0.1
# WORKER_CONCURRENCY=2

# Retention and export artifact storage (defaults shown; all configurable)
# RAW_AGGREGATE_RETENTION_DAYS=7
# MPDSR_EVENT_RETENTION_HOURS=24
# EXPORT_FILE_RETENTION_HOURS=24
# EXPORT_JOB_RETENTION_DAYS=90
# CALCULATION_SNAPSHOT_RETENTION_MONTHS=36
# AUDIT_LOG_RETENTION_MONTHS=24
# PURGE_ENABLED=true
# PURGE_DRY_RUN=false
# PURGE_BATCH_SIZE=500
# PURGE_MAX_BATCHES=200
# EXPORT_ARTIFACT_STORAGE=filesystem   # use "database" when API and worker have no shared disk
# EXPORT_ARTIFACT_MAX_BYTES=26214400

# Export queue tuning (defaults shown)
# EXPORT_MAX_ATTEMPTS=3
# EXPORT_RETRY_BACKOFF_SECONDS=15
# EXPORT_RETRY_BACKOFF_MAX_SECONDS=300
# EXPORT_JOB_LEASE_SECONDS=900

# Governance switches. Leave unset until the owner decides; unset values fail closed.
# FORMULA_UNDATED_FALLBACK=
# MPDSR_CAUSE_MIN_CELL_COUNT=

# Integrations (owner inputs; leave empty until verified)
# DHIS2_BASE_URL=
# DHIS2_AUTH_METHOD=basic
# DHIS2_USERNAME=
# DHIS2_PASSWORD=
# DHIS2_PAT=
# AI_ENABLED=false
# AI_PROVIDER=
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
