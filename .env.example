# Uganda Health Performance Intelligence Platform — environment placeholders
# Copy to `.env` for local development. Never commit real secrets.

APP_NAME=Uganda Health Performance Intelligence Platform
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# PostgreSQL (production and shared local development)
# Example: postgresql+psycopg://hpip:change-me@localhost:5432/hpip_dev
DATABASE_URL=postgresql+psycopg://hpip:change-me@localhost:5432/hpip_dev

# Authentication — use a long random value in every real environment
AUTH_SECRET=replace-with-a-long-random-development-secret-at-least-32-chars
AUTH_TOKEN_TTL_MINUTES=120
AUTH_COOKIE_NAME=hpip_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_CSRF_COOKIE_NAME=hpip_csrf
AUTH_CSRF_HEADER_NAME=x-csrf-token
AUTH_ISSUER=hpip-api
AUTH_AUDIENCE=hpip-web
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300
POPULATION_YEAR_MIN=2000
POPULATION_YEAR_MAX=2100
# queue (requires a broker and worker) or eager (development only)
SYNC_EXECUTION=eager

# Development seed only. Must remain false in staging/production.
SEED_DEV_DATA=true
SEED_PASSWORD=dev-only-change-me

# DHIS2 — configuration-driven; do not hard-code production credentials.
# Host text supplied by the project owner is approximately HMIS.hhs.go.ug.
# Exact production URL, auth method, and credentials remain unverified.
DHIS2_BASE_URL=
DHIS2_USERNAME=
DHIS2_PASSWORD=
DHIS2_PAT=
DHIS2_AUTH_METHOD=basic
DHIS2_API_PATH_PREFIX=/api
DHIS2_TIMEOUT_SECONDS=30
DHIS2_MAX_RETRIES=3
DHIS2_RETRY_BASE_SECONDS=0.2
DHIS2_RETRY_MAX_SECONDS=4
DHIS2_PAGE_SIZE=200
DHIS2_MAX_PAGES=50
DHIS2_MAX_RESPONSE_BYTES=5000000
DHIS2_OU_MODE=DESCENDANTS
DHIS2_STALE_HOURS=72

# Background jobs and rate limiting.
# There are no built-in broker or Redis defaults. Staging/production must set REDIS_URL,
# CELERY_BROKER_URL and CELERY_RESULT_BACKEND and keep EXPORT_EAGER=false and
# RATE_LIMIT_BACKEND=redis, or the API and worker refuse to start.
# Development without Redis must opt in explicitly to the per-process fallbacks below.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
RATE_LIMIT_BACKEND=memory
EXPORT_EAGER=true
# With a local Redis and `celery --app=app.workers.celery_app:celery_app worker --queues=exports,sync`:
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
# RATE_LIMIT_BACKEND=redis
# EXPORT_EAGER=false
EXPORT_MAX_ATTEMPTS=3
EXPORT_JOB_LEASE_SECONDS=900

# Where finished export bytes live: filesystem (shared disk) or database (no shared disk).
EXPORT_ARTIFACT_STORAGE=filesystem
EXPORT_ARTIFACT_MAX_BYTES=26214400

# Retention. Routine DHIS2 data is a short-lived cache; results and audit are retained.
RAW_AGGREGATE_RETENTION_DAYS=7
MPDSR_EVENT_RETENTION_HOURS=24
EXPORT_FILE_RETENTION_HOURS=24
EXPORT_JOB_RETENTION_DAYS=90
CALCULATION_SNAPSHOT_RETENTION_MONTHS=36
AUDIT_LOG_RETENTION_MONTHS=24
PURGE_ENABLED=true
PURGE_DRY_RUN=false
PURGE_SCHEDULE_ENABLED=false
PURGE_BATCH_SIZE=500
PURGE_MAX_BATCHES=200
PURGE_LOCK_TIMEOUT_SECONDS=900

# Undated legacy formula versions: unset = permitted in development/test only.
# Staging/production must set this explicitly once the owner decides (see OPEN_ITEMS).
# FORMULA_UNDATED_FALLBACK=

# AI Gateway — disabled unless AI_ENABLED=true and a key + base URL are supplied
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_ENABLED=false
AI_TIMEOUT_SECONDS=20
AI_MAX_TOKENS=800
AI_PROMPT_VERSION=hpip-ai-1
AI_MAX_EVIDENCE_CHARS=20000
AI_RATE_LIMIT=20
EXPORT_DIR=./export_artifacts
EXPORT_RATE_LIMIT=30

# Frontend (Next.js). Used when the UI is started from `frontend/`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
